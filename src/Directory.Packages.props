    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Primitives" Version="10.0.14" />
    <PackageVersion Include="ProjectDefaults" Version="1.0.187" />
    <PackageVersion Include="Sbom" Version="0.3.1" />
    <PackageVersion Include="Verify.Http" Version="8.0.1" />
    <PackageVersion Include="Verify.TUnit" Version="33.3.4" />
    <PackageVersion Include="TUnit" Version="1.79.0" />
    <PackageVersion Include="DiffEngine" Version="20.8.2" />
    <PackageVersion Include="EmptyFiles" Version="8.20.1" />
    <PackageVersion Include="SimpleInfoName" Version="3.2.1" />
    <PackageVersion Include="Verify" Version="33.3.4" />
